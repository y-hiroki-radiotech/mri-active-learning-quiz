<script>
function setTR(tr){
  document.getElementById('tr3').classList.toggle('active',tr===3);
  document.getElementById('tr5').classList.toggle('active',tr===5);
  document.getElementById('tr8').classList.toggle('active',tr===8);
  const period=1000/tr;
  document.getElementById('bandText').textContent='profile周期：約'+Math.round(period)+' Hz';
  drawCurve(tr);
}
function drawCurve(tr){
  const path=document.getElementById('bandCurve');
  const xmin=-600,xmax=600;
  let d='';
  for(let i=0;i<=500;i++){
    const f=xmin+(xmax-xmin)*i/500;
    const phase=2*Math.PI*f*(tr/1000);
    // educational schematic: periodic pass band with deep transition nulls
    const s=0.12+0.88*Math.abs(Math.cos(phase/2));
    const x=80+810*i/500;
    const y=240-180*s;
    d+=(i===0?'M':'L')+x.toFixed(1)+' '+y.toFixed(1)+' ';
  }
  path.setAttribute('d',d);
}
drawCurve(3);
</script>
