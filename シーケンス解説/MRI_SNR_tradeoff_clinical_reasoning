<script>
function v(id){ return parseFloat(document.getElementById(id).value); }
function calcSNR(){
  const vox1=(v('fovx1')/v('mx1'))*(v('fovy1')/v('my1'))*v('sl1');
  const vox2=(v('fovx2')/v('mx2'))*(v('fovy2')/v('my2'))*v('sl2');
  const s1=vox1*Math.sqrt(v('nex1'))/Math.sqrt(v('bw1'))/Math.sqrt(v('r1'));
  const s2=vox2*Math.sqrt(v('nex2'))/Math.sqrt(v('bw2'))/Math.sqrt(v('r2'));
  const ratio=s2/s1;
  const pct=(ratio-1)*100;
  const dir = pct>=0 ? "増加" : "低下";
  document.getElementById('result').textContent =
    `変更後 / 変更前 = ${ratio.toFixed(2)}×（約${Math.abs(pct).toFixed(0)}% ${dir}）`;
}
calcSNR();
</script>
