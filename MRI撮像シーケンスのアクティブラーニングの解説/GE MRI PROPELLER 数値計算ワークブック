</main>
<script>
function fnum(x,n=6){return Number(x).toFixed(n)}
function wrapDeg(d){let w=((d+180)%360+360)%360-180; return w===-180?180:w}
function calcPhase(){
  const fov=+document.getElementById('fov').value, dx=+document.getElementById('dx').value, dy=+document.getElementById('dy').value;
  const nx=+document.getElementById('nx').value, ny=+document.getElementById('ny').value;
  const kx=nx/fov, ky=ny/fov;
  const cycles=kx*dx+ky*dy;
  const phiRad=-2*Math.PI*cycles;
  const phiDeg=phiRad*180/Math.PI;
  const sx=-360*dx/fov, sy=-360*dy/fov;
  const corr=-phiDeg;
  document.getElementById('phaseOut').textContent =
`Δk = 1/FOV = ${fnum(1/fov,7)} mm^-1\n`+
`kx = nx/FOV = ${fnum(kx)} mm^-1\nky = ny/FOV = ${fnum(ky)} mm^-1\n\n`+
`k·Δr = kx·Δx + ky·Δy\n       = ${fnum(cycles)} cycle\n\n`+
`移動が作る位相 = -2π(k·Δr)\n  = ${fnum(phiRad)} rad\n  = ${fnum(phiDeg,3)}°\n  = wrapすると ${fnum(wrapDeg(phiDeg),3)}°\n\n`+
`1 indexあたりの傾き:\n  x: ${fnum(sx,3)}°/index\n  y: ${fnum(sy,3)}°/index\n\n`+
`補正で掛ける位相 = ${fnum(corr,3)}° (符号を逆にする)`;
}
function calcRot(){
  const th=+document.getElementById('theta').value, kx=+document.getElementById('rkx').value, ky=+document.getElementById('rky').value;
  const r=th*Math.PI/180, c=Math.cos(r), s=Math.sin(r);
  const x2=kx*c-ky*s, y2=kx*s+ky*c;
  const x3=x2*c+y2*s, y3=-x2*s+y2*c; // R(-θ)
  document.getElementById('rotOut').textContent =
`cosθ = ${fnum(c)}\nsinθ = ${fnum(s)}\n\n`+
`R(+θ) · [kx, ky]^T\n`+
`kx' = ${fnum(x2)} mm^-1\nky' = ${fnum(y2)} mm^-1\n\n`+
`逆回転 R(-θ) を適用:\n`+
`kx'' = ${fnum(x3)} mm^-1\nky'' = ${fnum(y3)} mm^-1\n\n`+
`→ 元の (${fnum(kx)}, ${fnum(ky)}) に戻る`;
}
calcPhase();calcRot();
</script>
